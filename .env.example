# CortexAI Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# LLM Providers
MISTRAL_API_KEY=your-mistral-api-key-here
GROQ_API_KEY=your-groq-api-key-here
ORCHESTRATOR_MODEL=mistral-medium-latest
FAST_MODEL=mistral-small-latest

# Search Providers
TAVILY_API_KEY=your-tavily-api-key-here
EXA_API_KEY=your-exa-api-key-here
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/cortexai
POSTGRES_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme

# Authentication (JWT + OAuth2)
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Application
WORKSPACE_ROOT=./data/workspaces
LANCEDB_PERSIST_DIR=./data/lancedb
MCP_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
RATE_LIMIT_REQUESTS_PER_MINUTE=60
GUARD_MAX_USD=10.0
GUARD_ENABLE_PII_REDACTION=true
GUARD_ENABLE_INJECTION_SHIELD=true
GUARD_ENABLE_OUTPUT_MODERATION=true
